---
import { profile } from '../data/site';

const links = [
  {
    href: `mailto:${profile.email}`,
    label: 'Email',
    value: profile.email,
    icon: 'mail',
  },
  {
    href: profile.github,
    label: 'GitHub',
    value: 'github.com/aoblea',
    icon: 'github',
  },
  {
    href: profile.linkedin,
    label: 'LinkedIn',
    value: 'in/arwinoblea',
    icon: 'linkedin',
  },
] as const;
---

<section class="section contact" id="contact">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">04 — Contact</p>
      <h2>Let's talk</h2>
      <span class="rule"></span>
    </div>

    <div class="contact__grid">
      <div>
        <p class="contact__pitch">
          Want to chat? Reach out. I'd like to hear from you.
        </p>
        <a class="btn btn--solid contact__cta" href={`mailto:${profile.email}`}>Say hello</a>
      </div>

      <ul class="contact__links">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                target={link.href.startsWith('mailto:') ? undefined : '_blank'}
                rel={link.href.startsWith('mailto:') ? undefined : 'noopener'}
              >
                <span class="contact__icon" aria-hidden="true">
                  {link.icon === 'mail' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                      <path d="m3.5 6.5 8.5 6 8.5-6" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                  )}
                  {link.icon === 'github' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 .5a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58v-2.2c-3.34.72-4.04-1.42-4.04-1.42-.55-1.4-1.34-1.77-1.34-1.77-1.1-.75.08-.73.08-.73 1.2.09 1.84 1.24 1.84 1.24 1.07 1.84 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.34-5.47-5.96 0-1.32.47-2.39 1.24-3.23-.13-.3-.54-1.53.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6.01 0c2.29-1.55 3.3-1.23 3.3-1.23.65 1.65.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.23 0 4.63-2.8 5.65-5.48 5.95.43.37.82 1.1.82 2.22v3.29c0 .32.21.7.82.58A12 12 0 0 0 12 .5Z" />
                    </svg>
                  )}
                  {link.icon === 'linkedin' && (
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6.5 0h3.83v1.64h.05c.53-1 1.84-2.06 3.78-2.06 4.04 0 4.79 2.66 4.79 6.12V21h-4v-5.5c0-1.31-.02-3-1.83-3-1.83 0-2.11 1.43-2.11 2.9V21h-4V9Z" />
                    </svg>
                  )}
                </span>
                <span class="contact__text">
                  <span class="contact__label">{link.label}</span>
                  <span class="contact__value">{link.value}</span>
                </span>
                <svg class="contact__arrow" viewBox="0 0 16 16" aria-hidden="true">
                  <path
                    d="M4.5 11.5 11.5 4.5M6 4.5h5.5V10"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .contact__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .contact__pitch {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.6rem);
    line-height: 1.4;
    max-width: 26ch;
  }

  .contact__cta {
    margin-top: 1.75rem;
  }

  .contact__links {
    display: grid;
    border-top: 1px solid var(--ink-line);
  }

  .contact__links a {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--ink-line);
    text-decoration: none;
    transition: padding-inline 0.2s ease;
  }

  .contact__links a:hover {
    padding-inline: 0.5rem 0;
  }

  .contact__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .contact__text {
    display: grid;
    gap: 0.1rem;
  }

  .contact__label {
    font-family: var(--mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact__value {
    font-size: 0.95rem;
  }

  .contact__arrow {
    width: 1rem;
    height: 1rem;
    color: var(--ink-faint);
    transition: transform 0.2s ease, color 0.2s ease;
  }

  .contact__links a:hover .contact__arrow {
    transform: translate(2px, -2px);
    color: var(--ink);
  }

  @media (max-width: 52rem) {
    .contact__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
