---
const facts = [
  { label: 'Working in', value: 'Swift & SwiftUI' },
  { label: 'Shipping', value: 'Apps and SDKs' },
  { label: 'Currently', value: 'Building HatawSet' },
];
---

<section class="section" id="about">
  <div class="shell">
    <div class="section-head">
      <p class="eyebrow">01 — About</p>
      <h2>A bit about me</h2>
      <span class="rule"></span>
    </div>

    <div class="about">
      <div class="about__prose">
        <p class="about__lead">
          I'm a software engineer who builds for Apple platforms. Most of my work is native iOS —
          apps and SDKs written in Swift and SwiftUI, built to be quick, dependable, and pleasant to
          use every day.
        </p>

        <p>
          I care about the parts people never see: architecture that stays tidy as a project grows,
          tests that catch the problem before anyone else does, and code the next engineer can pick
          up without a map. I care just as much about the parts people do see. An app should feel
          obvious the first time you open it, then stay out of your way after that.
        </p>

        <p>
          I like working with other people on hard problems, and I like the moment something finally
          clicks into place. Mostly, though, it comes down to something simple: I like to build
          things.
        </p>
      </div>

      <aside class="about__facts" aria-label="At a glance">
        <ul>
          {
            facts.map((fact) => (
              <li>
                <span class="about__facts-label">{fact.label}</span>
                <span class="about__facts-value">{fact.value}</span>
              </li>
            ))
          }
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 4.5rem);
    align-items: start;
  }

  .about__prose {
    display: grid;
    gap: 1.35rem;
    max-width: var(--measure);
    color: var(--ink-muted);
  }

  .about__lead {
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.6rem);
    line-height: 1.4;
    color: var(--ink);
  }

  .about__facts ul {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink-line);
  }

  .about__facts li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--ink-line);
  }

  .about__facts-label {
    font-family: var(--mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .about__facts-value {
    font-size: 0.95rem;
    text-align: right;
  }

  @media (max-width: 52rem) {
    .about {
      grid-template-columns: 1fr;
    }
  }
</style>
