---
import { profile } from '../data/site';
import { withBase } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="shell footer__inner">
    <p class="footer__note">© {year} {profile.name}</p>

    <nav class="footer__legal" aria-label="Legal">
      <span class="footer__legal-label">Pork Sliders</span>
      <a href={withBase('/pork-sliders/privacy')}>Privacy</a>
      <a href={withBase('/pork-sliders/terms')}>Terms</a>
    </nav>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--ink-line);
    padding-block: 2rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
  }

  .footer__note,
  .footer__legal {
    font-family: var(--mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--ink-muted);
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.25rem;
  }

  .footer__legal-label {
    color: var(--ink-faint);
  }

  .footer__legal a {
    text-decoration: none;
  }

  .footer__legal a:hover {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }
</style>
